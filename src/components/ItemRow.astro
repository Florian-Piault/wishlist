---
// Une ligne de la liste : toute la ligne est le lien marchand, ouvert dans un
// nouvel onglet. Vignette à gauche, titre et note au centre, prix à droite.
// Le texte du YAML passe par `{…}` : Astro l'échappe.
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Star from "@lucide/astro/icons/star";
import type { CategoryIconName } from "../lib/categories";
import { formatItemPrice, type Item } from "../lib/wishlist";
import CategoryIcon from "./CategoryIcon.astro";

interface Props {
  item: Item;
  /** Icône de repli, fournie par le groupe de la catégorie. */
  icon: CategoryIconName;
}

const { item, icon } = Astro.props;
---

<a class="row" href={item.url} target="_blank" rel="noopener noreferrer">
  <CategoryIcon name={icon} />
  <div class="body">
    {item.priority === "high" && (
      <p class="wish">
        <Star aria-hidden="true" stroke-width={1.75} />
        Très envie
      </p>
    )}
    <p class="title">{item.title}</p>
    {item.note && <p class="note">{item.note}</p>}
  </div>
  <p class="price">
    {formatItemPrice(item)}
    <ArrowUpRight aria-hidden="true" stroke-width={1.75} />
  </p>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 14px 0;
    text-decoration: none;
  }

  @media (min-width: 600px) {
    .row {
      grid-template-columns: 88px 1fr auto;
    }
  }

  .row:hover .title,
  .row:focus-visible .title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  p {
    margin: 0;
  }

  .body {
    min-width: 0;
  }

  .wish {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 2px;
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .title {
    font-weight: 500;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .note {
    margin-top: 2px;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    color: var(--color-price);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  /* Les SVG sont rendus par Lucide, hors de la portée de ce composant. */
  .wish :global(svg),
  .price :global(svg) {
    width: 1em;
    height: 1em;
    flex: none;
  }

  .price :global(svg) {
    color: var(--color-muted);
    font-size: 0.95rem;
  }
</style>
